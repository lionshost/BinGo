# Sao chép thành backend/.env khi chạy local. Trên Render, khai báo trong tab Environment.

PORT=3000
NODE_ENV=development

# PostgreSQL (Neon / Supabase / Render). Để trống = đọc dữ liệu mẫu từ data/*.json
DATABASE_URL=
# Đặt false khi dùng Postgres local không có SSL
DATABASE_SSL=true

# Các domain frontend được gọi API, cách nhau bằng dấu phẩy (không có / ở cuối)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# VIETMAP
VIETMAP_TILEMAP_KEY=
VIETMAP_SERVICES_KEY=
VIETMAP_VEHICLE=car
VIETMAP_TRUCK_WEIGHT_KG=

# Gemini Vision (phân tích ảnh thùng rác)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
