# Sao chép thành backend/.env khi chạy local. Trên Render, khai báo trong tab Environment.

PORT=3000
NODE_ENV=development

# PostgreSQL (Neon / Supabase / Render). Để trống = đọc dữ liệu mẫu từ data/*.json
DATABASE_URL=
# Đặt false khi dùng Postgres local không có SSL
DATABASE_SSL=true

# Các domain frontend được gọi API, cách nhau bằng dấu phẩy (không có / ở cuối)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# VIETMAP
# Key này lộ ra trình duyệt (bắt buộc). Hãy vào dashboard VietMap, giới hạn key
# theo domain/referrer của frontend và dùng key RIÊNG, khác VIETMAP_SERVICES_KEY.
VIETMAP_TILEMAP_KEY=
VIETMAP_SERVICES_KEY=
VIETMAP_VEHICLE=car
VIETMAP_TRUCK_WEIGHT_KG=

# Computer vision (YOLOv8 ONNX, chạy tại máy chủ) là bộ phân tích ảnh chính.
# Mặc định dùng models/trashscan8s.onnx; đặt đường dẫn khác nếu muốn thay mô hình.
CV_MODEL_PATH=

# Gemini Vision — chỉ là dự phòng khi CV lỗi/không đủ tin cậy (để trống = tắt dự phòng)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Đăng nhập / đăng ký
# Chuỗi ngẫu nhiên dài để ký token phiên. BẮT BUỘC ở production, tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# Thời hạn phiên (ngày)
AUTH_TOKEN_DAYS=7
# Đăng nhập Google: Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web). Thêm Authorized JavaScript origins = domain frontend
# (vd http://localhost:5173). Để trống = ẩn nút Google.
GOOGLE_CLIENT_ID=

# Email được cấp quyền admin (cách nhau bằng dấu phẩy). Chỉ có hiệu lực khi đăng nhập bằng Google,
# vì email đăng ký thường chưa được xác minh. Có thể dùng thay: npm run make-admin -- email@x.com
# hoặc tạo tài khoản admin email + mật khẩu: ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run create-admin
ADMIN_EMAILS=
ADMIN_PASSWORD=